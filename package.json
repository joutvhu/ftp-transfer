{
  "name": "ftp-transfer",
  "version": "1.0.2",
  "description": "GitHub Action to transfer files to and from a computer running an FTP server service.",
  "scripts": {
    "build": "npm run clean && tsc --project tsconfig.json",
    "release": "ncc build src/ftp-transfer.ts -o action && git add -f action/",
    "clean": "rimraf -- action",
    "lint": "eslint **/*.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "actions",
    "github",
    "ftp"
  ],
  "author": {
    "name": "Giao Ho",
    "email": "joutvhu@gmail.com",
    "url": "https://github.com/joutvhu"
  },
  "license": "MIT",
  "homepage": "https://github.com/joutvhu/ftp-transfer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/joutvhu/ftp-transfer.git"
  },
  "bugs": {
    "url": "https://github.com/joutvhu/ftp-transfer/issues"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "ftp": "^0.3.10",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.13",
    "@types/ftp": "^0.3.36",
    "@types/node": "^24.13.6",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  }
}
